{
    "name": "dsh-composer-ux",
    "version": "0.3.0",
    "description": "DSH Web 输入体验增强插件：可配置发送/换行键位 + 自定义输入框右键菜单 + 面板尺寸记忆 + 快捷指令（分类 / 默认插入 / 存 ~/.dsh/quick-prompts.json）+ 提示词优化 + OpenCode 会话请求头（含设置页）",
    "type": "module",
    "main": "./lib/index.js",
    "exports": {
        ".": "./lib/index.js",
        "./client": {
            "default": "./lib/client.js"
        }
    },
    "files": [
        "lib",
        "cordis.patch.yml",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "keywords": [
        "dsh-plugin",
        "dsh",
        "deepseek-harness",
        "cordis",
        "web",
        "input",
        "context-menu",
        "settings",
        "opencode"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/fangwen9527/dsh-composer-ux.git"
    },
    "dsh": {
        "client": {
            "platform": "web",
            "inject": [
                "slots",
                "settingsScope"
            ]
        },
        "bundle": {
            "patch": "./cordis.patch.yml"
        }
    },
    "scripts": {
        "build": "node build.mjs",
        "test": "node test/host-header-mirror.mjs && node test/quick-commands.mjs && node test/quick-store.mjs && node test/client-registration.mjs"
    },
    "devDependencies": {
        "esbuild": "^0.25.0"
    }
}
